# ============================================================================
# SentinelChain — Docker Environment Variables
# Copy this file to .env in the project root before running docker compose
# ============================================================================

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sentinelchain_db_password_2026
DB_PORT=5432

# ── Express API Server ──
NODE_ENV=production
API_PORT=5000
JWT_SECRET=your_jwt_secret_here_minimum_64_chars_long_for_security
JWT_EXPIRES_IN=7d

# ── Blockchain (Polygon Amoy Testnet) ──
PRIVATE_KEY=your_wallet_private_key
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
CONTRACT_ADDRESS=0x1111111111111111111111111111111111111111
CHAIN_ID=80002

# ── IPFS / Pinata ──
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── AI Service ──
OPENAI_API_KEY=your_openai_api_key
AI_MODEL_NAME=gpt-4o
AI_DEBUG=false
AI_PORT=8000

# ── Client ──
CLIENT_PORT=3000
